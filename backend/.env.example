# Django
DJANGO_SETTINGS_MODULE=ecommerce.settings.development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-string

# Comma-separated; production must list your actual host(s)
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database — sqlite for local default; use postgres URL in prod
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Redis (optional locally; falls back to LocMemCache if unset)
# REDIS_URL=redis://localhost:6379/0

# AWS S3 (optional; only used when USE_S3=true)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Sentry (optional)
SENTRY_DSN=

# Email (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shopnest.com
